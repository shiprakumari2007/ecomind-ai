# EcoMind AI Environment Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Optional: Google Gemini API Key for conversational AI
# If not provided, EcoMind AI automatically uses an intelligent rule-based / data-grounded fallback assistant
GEMINI_API_KEY=

# Default Energy & Carbon Factors
DEFAULT_ELECTRICITY_RATE=0.15      # Currency / kWh
DEFAULT_CARBON_FACTOR=0.72         # kg CO2 / kWh (grid emission factor)
DEFAULT_CURRENCY=USD               # USD, EUR, GBP, INR, etc.
DATABASE_URL=sqlite:///./backend/ecomind.db
